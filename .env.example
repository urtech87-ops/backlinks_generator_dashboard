# Copy to .env and fill in what you have. Blanks degrade gracefully — the
# dashboard falls back to seed data, briefs and disabled buttons rather than
# crashing. Everything here is editable from the Settings page in the app.

# ---- Google service account (Search Console + GA4) ----
# Path is relative to the project folder. Grant its client_email access in
# Search Console (Settings -> Users) and GA4 (Admin -> Property access).
GOOGLE_SA_FILE=config/service_account.json

# ---- Site 1: ToolsVenue (prefix TV) ----
TV_GSC_PROPERTY=https://toolsvenue.com/
TV_SITEMAP=https://toolsvenue.com/sitemap_index.xml
TV_HOMEPAGE=https://toolsvenue.com/
TV_GA4_ID=
TV_WP_URL=https://toolsvenue.com
TV_WP_USERNAME=
TV_WP_APP_PASSWORD=

# ---- Site 2: ToolAcademy (prefix TA) ----
TA_GSC_PROPERTY=https://toolacademy.com/
TA_SITEMAP=https://toolacademy.com/sitemap_index.xml
TA_HOMEPAGE=https://toolacademy.com/
TA_GA4_ID=
TA_WP_URL=https://toolacademy.com
TA_WP_USERNAME=
TA_WP_APP_PASSWORD=

# ---- OpenRouter + per-agent models ----
# Cheap for analysis/backlinks (high volume, simple judgement), strongest for
# content (it has to rank). The Settings page lists what your key can call.
OPENROUTER_API_KEY=
ANALYSIS_MODEL=anthropic/claude-haiku-4-5
BACKLINK_MODEL=anthropic/claude-haiku-4-5
CONTENT_MODEL=anthropic/claude-opus-5

# ---- Image API (pluggable; dummy = writes briefs instead) ----
IMAGE_API_PROVIDER=dummy
IMAGE_API_KEY=REPLACE_ME_LATER
IMAGE_MODEL=REPLACE_ME_LATER

# ---- Keyword API (optional; GSC query data works without this) ----
KEYWORD_API_PROVIDER=dummy
KEYWORD_API_KEY=REPLACE_ME_LATER

# ---- WordPress fallback ----
# The per-site TV_WP_* / TA_WP_* keys above are what the dashboard uses. These
# single keys are the fallback, and are what the standalone wordpress-publisher
# skill reads when run outside the dashboard. Publishing is ALWAYS a draft.
WP_SITE_URL=https://toolsvenue.com
WP_USERNAME=
WP_APP_PASSWORD=

# ---- Owned backlink platforms (Phase 3) ----
# Auto-publishing is only ever allowed on platforms you own.
DEVTO_API_KEY=
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# ---- Optional email for guest outreach (Phase 4) ----
# Nothing sends without an explicit human click.
OUTREACH_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
