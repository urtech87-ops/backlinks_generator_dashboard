# ---- Google service account (Search Console + GA4) ----
GOOGLE_SA_FILE=config/service_account.json

# ---- Sites ----
TV_GSC_PROPERTY=https://toolsvenue.com/
TV_SITEMAP=https://toolsvenue.com/sitemap_index.xml
TV_GA4_ID=
TA_GSC_PROPERTY=https://toolacademy.com/
TA_SITEMAP=https://toolacademy.com/sitemap_index.xml
TA_GA4_ID=

# ---- OpenRouter + per-agent models (cheap for analysis/backlinks, strong for content) ----
OPENROUTER_API_KEY=
ANALYSIS_MODEL=anthropic/claude-haiku-4-5
BACKLINK_MODEL=anthropic/claude-haiku-4-5
CONTENT_MODEL=anthropic/claude-opus-4-8

# ---- Image API (pluggable; dummy = writes briefs) ----
IMAGE_API_PROVIDER=dummy
IMAGE_API_KEY=REPLACE_ME_LATER
IMAGE_MODEL=REPLACE_ME_LATER

# ---- Keyword API (optional; GSC-first works without this) ----
KEYWORD_API_PROVIDER=dummy
KEYWORD_API_KEY=REPLACE_ME_LATER

# ---- WordPress (per site; draft publishing) ----
WP_SITE_URL=https://toolsvenue.com
WP_USERNAME=
WP_APP_PASSWORD=

# ---- Owned backlink platforms (Phase 3) ----
DEVTO_API_KEY=
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# ---- Optional email for guest outreach (Phase 4) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
